  "method": null,
  "ok": true,
  "source": "// LeetCode 20. Valid Parentheses — subset-friendly (no map iterators).\n// Run: cargo run -p rscpp-pipeline -- examples/valid_parentheses.cpp\n// Or: run_method(src, \"Solution::isValid\", [\"()[]{}\"])\n\nclass Solution {\npublic:\n    bool isValid(string s) {\n        stack<char> st;\n        for (const auto& c : s) {\n            if (c == '(' || c == '[' || c == '{') {\n                st.emplace(c);\n            } else {\n                if (st.empty()) {\n                    return false;\n                }\n                char top = st.top();\n                st.pop();\n                if (c == ')' && top != '(') {\n                    return false;\n                }\n                if (c == ']' && top != '[') {\n                    return false;\n                }\n                if (c == '}' && top != '{') {\n                    return false;\n                }\n            }\n        }\n        return st.empty();\n    }\n};\n\nint main() {\n    Solution sol;\n    // \"()[]{}\" is valid → return 1\n    if (!sol.isValid(\"()[]{}\")) {\n        return 0;\n    }\n    // \"(]\" is invalid → return 1 only if both checks pass\n    if (sol.isValid(\"(]\")) {\n        return 0;\n    }\n    return 1;\n}\n",
  "value": {
    "kind": "Int",
    "value": 1
  }
